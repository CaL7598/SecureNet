# Copy to ".env" in this folder (the repo root .gitignore already ignores .env).
# See SUPABASE_SETUP.md for where to get DATABASE_URL.

# Supabase: Project Settings → Database → Connection string → URI
# Use Session pooler (port 6543) or Direct (5432) — see SUPABASE_SETUP.md.
DATABASE_URL=postgresql://postgres.REPLACE:REPLACE_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

DEBUG=true
JWT_SECRET=replace-with-strong-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
RATE_LIMIT_REQUESTS_PER_MINUTE=120
